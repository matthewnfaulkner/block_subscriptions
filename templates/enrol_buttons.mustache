<div class="p-3">
{{#hasmainsubscription}}
    {{#iscohortmember}}
        {{#gwpayments}}
        
            {{#enrolledincourse}}
                {{#canupgrade}}
                    {{! An expired subscription gets the purchase button below instead. }}
                    {{^isexpired}}
                        <h5> {{# str }} upgradesubscription, block_subscriptions {{/ str }} </h5>
                    {{/isexpired}}
                {{/canupgrade}}
                {{^isexpired}}
                    {{#canresubscribe}}
                        <h5> {{# str }} renewsubscription, block_subscriptions {{/ str }} </h5>
                    {{/canresubscribe}}
                {{/isexpired}}
                {{#isexpired}}
                    <h5> {{# str }} renewsubscription, block_subscriptions {{/ str }} </h5>
                {{/isexpired}}
            {{/enrolledincourse}}
            {{^enrolledincourse}}
                {{#isexpired}}
                    <h5> {{# str }} renewsubscription, block_subscriptions {{/ str }} </h5>
                {{/isexpired}}
                {{^isexpired}}
                    <h5> {{# str }} purchasesubscription, block_subscriptions {{/ str }} </h5>
                {{/isexpired}}
            {{/enrolledincourse}}
            {{> local_shopping_cart/addtocartdb }}
            {{#hasbundles}}
                {{> block_subscriptions/bundles }}
            {{/hasbundles}}
        {{/gwpayments}}
        {{^gwpayments}}
            <a class="btn btn-primary action-subscribe-{{subscriptionid}}" href="{{{enrollink}}}">
                {{#str}}enrol, block_subscriptions, {{/str}}
            </a>
        {{/gwpayments}}
    {{/iscohortmember}}
    {{^iscohortmember}}
        <a class="btn btn-dark disabled">
            {{#str}}enrollmentunavailable, block_subscriptions, {{/str}}
        </a>
        {{#hasbundles}}
                {{> block_subscriptions/bundles }}
        {{/hasbundles}}
    {{/iscohortmember}}
{{/hasmainsubscription}}
{{^hasmainsubscription}}
    <a class="btn btn-dark disabled">
            {{#str}}enrollmentunavailablenomain, block_subscriptions, {{/str}}
    </a>
    {{> local_shopping_cart/addtocartdb }}
    {{#hasbundles}}
                {{> block_subscriptions/bundles }}
    {{/hasbundles}}
{{/hasmainsubscription}}
</div>